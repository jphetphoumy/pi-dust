{
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just typecheck)",
      "Bash(just coverage)",
      "Bash(just prepush)",
      "Bash(just changelog)",
      "Bash(just commitlint)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run coverage)",
      "Bash(npm run prepush)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c);process.stdin.on(\"end\",()=>{try{const j=JSON.parse(d);process.stdout.write(j.tool_input && j.tool_input.file_path || \"\")}catch(e){}})'); case \"$f\" in *.ts) npx eslint \"$f\" --max-warnings=0 ;; esac",
            "timeout": 30,
            "statusMessage": "Linting changed file..."
          }
        ]
      }
    ]
  }
}
