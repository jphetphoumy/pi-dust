{
  "name": "pi-dust-extension",
  "version": "0.1.0",
  "description": "Pi extension that connects Dust agents to the Pi coding agent runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jphetphoumy/pi-dust.git"
  },
  "bugs": {
    "url": "https://github.com/jphetphoumy/pi-dust/issues"
  },
  "homepage": "https://github.com/jphetphoumy/pi-dust#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "coverage": "vitest --run --coverage --config vitest.config.ts",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:release-notes": "git-cliff --current --strip header --output RELEASE_NOTES.md",
    "validate:release-notes": "node scripts/validate-release-notes.mjs",
    "validate:tag-version": "node scripts/validate-tag-version.mjs",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "commitlint": "commitlint --edit",
    "precommit": "npm run check",
    "prepush": "npm run typecheck && npm run lint && npm run coverage",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "git-cliff": "^2.13.1",
    "globals": "^17.8.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.82.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run precommit",
    "pre-push": "npm run prepush",
    "commit-msg": "npm run commitlint -- \"$1\""
  },
  "pi": {
    "extensions": [
      "./src/dust.ts"
    ],
    "icon": "./icon.png"
  }
}
